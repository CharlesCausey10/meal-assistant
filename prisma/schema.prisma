generator client {
    provider   = "prisma-client-js"
    engineType = "library"
}

datasource db {
    provider = "postgresql"
}

enum Protein {
    CHICKEN_BREAST
    CHICKEN_THIGHS
    ROTISSERIE_CHICKEN
    GROUND_BEEF
    PORK_BUTT
    FISH
    EGGS
}

enum Category {
    BREAKFAST
    LUNCH
    DINNER
    SIDE_STARTER
    SNACK
    DESSERT
}

enum IngredientCategory {
    PRODUCE
    MEAT
    SEAFOOD
    DAIRY
    DRINKS
    GRAINS_BREAD
    NUTS_SEEDS
    BAKING
    OILS_VINEGARS
    CONDIMENTS
    CANNED_GOODS
    FROZEN
    SNACKS_CHIPS
    SPICES_HERBS
    SWEETS
    OTHER
}

enum HouseholdRole {
    OWNER
    MEMBER
}

model User {
    id           Int               @id @default(autoincrement())
    workosUserId String            @unique
    email        String            @unique
    firstName    String?
    lastName     String?
    memberships  HouseholdMember[]
    preferences  MealPreference[]
    createdAt    DateTime          @default(now())
    updatedAt    DateTime          @updatedAt
}

model Household {
    id                   Int               @id @default(autoincrement())
    workosOrganizationId String?           @unique
    inviteToken          String?           @unique
    inviteTokenCreatedAt DateTime?
    discoverableMealsOptIn Boolean?
    name                 String
    members              HouseholdMember[]
    meals                Meal[]
    ingredients          Ingredient[]
    mealLogs             MealLog[]
    groceryLists         GroceryList[]
    createdAt            DateTime          @default(now())
    updatedAt            DateTime          @updatedAt
}

model HouseholdMember {
    id          Int           @id @default(autoincrement())
    householdId Int
    userId      Int           @unique
    role        HouseholdRole @default(MEMBER)
    household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
    user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt

    @@unique([householdId, userId])
}

model Meal {
    id          Int              @id @default(autoincrement())
    householdId Int?
    household   Household?       @relation(fields: [householdId], references: [id], onDelete: Cascade)
    name        String
    protein     Protein?
    category    Category
    categories  MealCategory[]
    notes       String?
    recipeUrl   String?
    ingredients MealIngredient[]
    groceryUses GroceryListMeal[]
    mealLogs    MealLog[]
    preferences MealPreference[]
    createdAt   DateTime         @default(now())
    updatedAt   DateTime         @updatedAt
}

model MealCategory {
    id        Int      @id @default(autoincrement())
    mealId    Int
    meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
    category  Category
    createdAt DateTime @default(now())

    @@unique([mealId, category])
    @@index([category])
}

model Ingredient {
    id        Int                @id @default(autoincrement())
    householdId Int?
    household   Household?       @relation(fields: [householdId], references: [id], onDelete: Cascade)
    name      String
    category  IngredientCategory
    mealUses  MealIngredient[]
    groceryListItems GroceryListItem[]
    createdAt DateTime           @default(now())
    updatedAt DateTime           @updatedAt
}

model MealIngredient {
    id           Int        @id @default(autoincrement())
    mealId       Int
    meal         Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
    ingredientId Int
    ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
    quantity     Decimal
    unit         String
    createdAt    DateTime   @default(now())

    @@unique([mealId, ingredientId])
}

model MealLog {
    id        Int      @id @default(autoincrement())
    householdId Int?
    household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
    name      String
    protein   Protein?
    cookedAt  DateTime
    mealId    Int?
    meal      Meal?    @relation(fields: [mealId], references: [id], onDelete: SetNull)
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())

    @@index([householdId, isActive, cookedAt])
    @@index([mealId, isActive, cookedAt])
}

model GroceryList {
    id          Int               @id @default(autoincrement())
    householdId Int?
    household   Household?        @relation(fields: [householdId], references: [id], onDelete: Cascade)
    name        String
    notes       String?
    items       GroceryListItem[]
    sourceMeals GroceryListMeal[]
    createdAt   DateTime          @default(now())
    updatedAt   DateTime          @updatedAt
}

model MealPreference {
    id        Int      @id @default(autoincrement())
    userId    Int
    mealId    Int
    score     Int
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, mealId])
}

model GroceryListMeal {
    id            Int         @id @default(autoincrement())
    groceryListId Int
    mealId        Int
    groceryList   GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
    meal          Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)
    createdAt     DateTime    @default(now())

    @@unique([groceryListId, mealId])
}

model GroceryListItem {
    id            Int                 @id @default(autoincrement())
    groceryListId Int
    ingredientId  Int?
    nameSnapshot  String
    category      IngredientCategory?
    quantity      Decimal?
    unit          String?
    note          String?
    isChecked     Boolean             @default(false)
    sortOrder     Int                 @default(0)
    groceryList   GroceryList         @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
    ingredient    Ingredient?         @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
    createdAt     DateTime            @default(now())
    updatedAt     DateTime            @updatedAt

    @@index([groceryListId, isChecked])
    @@index([groceryListId, category])
}
